# =============================================================================
# Personal Panopticon - Environment Configuration
# =============================================================================

# Environment
NODE_ENV=development

# =============================================================================
# Database (PostgreSQL - unified for local and production)
# =============================================================================

# Local development (Docker Compose)
DATABASE_URL="postgresql://panopticon:panopticon@localhost:5432/panopticon"

# Railway will auto-set this in production
# DATABASE_URL=postgresql://...

# =============================================================================
# Redis (for BullMQ async job queue)
# =============================================================================

# Local development (Docker Compose)
REDIS_URL="redis://localhost:6379"

# Railway/Upstash will provide this in production
# REDIS_URL=redis://...

# =============================================================================
# LLM API Keys
# =============================================================================

# Gemini (Google) - Fast, good for general tasks
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Grok (xAI) - Best for X/Twitter context
# Get from: https://console.x.ai
XAI_API_KEY=

# Claude (Anthropic) - Best for complex reasoning
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI (optional)
OPENAI_API_KEY=

# =============================================================================
# Local LLM (Ollama)
# =============================================================================

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# =============================================================================
# Server
# =============================================================================

PORT=8000

# API key for protecting endpoints (optional)
API_KEY=

# =============================================================================
# X/Twitter API (for X agent)
# =============================================================================

# Get from: https://developer.twitter.com
X_BEARER_TOKEN=

# =============================================================================
# Frontend URL (for CORS)
# =============================================================================

FRONTEND_URL=http://localhost:3000

# =============================================================================
# Output & Prompts Directories
# =============================================================================

# Where to save generated reports (default: packages/server/output)
OUTPUT_DIR=

# Where to load custom prompts from (default: prompts/)
PROMPTS_DIR=

# =============================================================================
# Notifications (optional)
# =============================================================================

# Twilio for SMS
# TWILIO_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE=

# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
