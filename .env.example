# =============================================================================
# Personal Panopticon - Environment Configuration
# =============================================================================

# Environment: local | railway | hybrid
PANOPTICON_ENV=local

# =============================================================================
# LLM API Keys
# =============================================================================

# Grok (xAI) - Best for X/Twitter analysis
# Get from: https://console.x.ai
XAI_API_KEY=xai-xxxxxxxx

# Claude (Anthropic) - Best for complex reasoning
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# OpenAI (optional)
OPENAI_API_KEY=sk-xxxxxxxx

# =============================================================================
# Local LLM (Ollama)
# =============================================================================

# Ollama host (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# =============================================================================
# Database
# =============================================================================

# Railway will auto-set this
# DATABASE_URL=postgresql://user:pass@host:5432/db

# For local SQLite (default)
SQLITE_PATH=./data/panopticon.db

# Redis (optional, for caching/queues)
# REDIS_URL=redis://localhost:6379

# =============================================================================
# Server
# =============================================================================

PORT=8000
DEBUG=false

# API key for protecting endpoints (optional)
API_KEY=your-secret-key

# JWT secret for auth (change in production!)
JWT_SECRET=change-me-in-production

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# =============================================================================
# X/Twitter API (for X agent)
# =============================================================================

# Get from: https://developer.twitter.com
X_BEARER_TOKEN=AAAA...

# =============================================================================
# Notifications (optional)
# =============================================================================

# Twilio for SMS
# TWILIO_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE=

# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
